# Copy this file to .env.local and fill in the values.

# MySQL admin account: used ONLY by "npm run db:setup" to build the schema.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=your-mysql-root-password

# Limited account the web app connects with (db:setup creates it).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gym_db
MYSQL_USER=gym_app
MYSQL_PASSWORD=choose-a-long-random-password

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gym_mongo

# Signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-string
